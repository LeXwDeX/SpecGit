# The skills.sh distribution files are generated LF-only and compared
# byte-for-byte by test/core/templates/skillssh-parity.test.ts. Force LF on
# checkout so Windows autocrlf doesn't turn them into CRLF and fail parity.
skills/** text eol=lf

# The fake-gh scripted recorder (#189) is spawned through a POSIX node
# shebang: CRLF checkout on Windows would corrupt the shebang line, so pin
# LF exactly like the skills distribution files above.
test/specgit/helpers/fake-gh-script.cjs text eol=lf

# Vite's SSR shebang removal requires LF; this executable is also imported
# by the workspace configuration tests on Windows (#432).
scripts/ci-change-scope.mjs text eol=lf

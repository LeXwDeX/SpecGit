{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecGit 2 explicit native merge options",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "mode", "strategy"],
  "properties": {
    "request": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["now", "auto"] },
    "strategy": { "enum": ["merge", "squash", "rebase"] }
  }
}

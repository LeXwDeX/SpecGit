{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecGit 2 native issue options",
  "description": "Normalized native issue command options. The CLI uses positional specs and kebab-case flags; this is not a JSON-input transport.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specs"],
  "properties": {
    "specs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
    "body_file": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 }, "default": [] },
    "tags": { "type": ["array", "null"], "maxItems": 100, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:::[a-z0-9]+(?:-[a-z0-9]+)*)?$", "maxLength": 64 } },
    "branch": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
    "inspect": { "type": "boolean", "default": false }
  }
}

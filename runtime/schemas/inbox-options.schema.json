{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecGit 2 native inbox options",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "session", "goal"],
  "allOf": [
    {
      "if": { "required": ["no_refresh"], "properties": { "no_refresh": { "const": true } } },
      "then": { "properties": { "ack": { "type": "null" } } }
    }
  ],
  "properties": {
    "request": { "type": "integer", "minimum": 1 },
    "session": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "goal": { "enum": ["checks", "lifecycle"] },
    "state_root": { "type": ["string", "null"] },
    "no_refresh": { "type": "boolean", "default": false },
    "ack": { "type": ["string", "null"], "description": "Exact event ID; an explicit transport receipt, never proof of human reading." }
  }
}

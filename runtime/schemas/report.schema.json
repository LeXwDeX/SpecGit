{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecGit 2 JSON report",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "installation_id": {
      "enum": [
        "project_skill",
        "instruction_entry",
        "session_context",
        "tool_context",
        "git_guard",
        "observation",
        "local_exclusions",
        "private_state"
      ]
    },
    "installation_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "mode",
        "side_effects",
        "requires_project",
        "requires_network"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2
        },
        "mode": {
          "enum": [
            "preview",
            "apply",
            "read",
            "invoke",
            "observe"
          ]
        },
        "side_effects": {
          "type": "string",
          "minLength": 1
        },
        "requires_project": {
          "type": "boolean"
        },
        "requires_network": {
          "type": "boolean"
        }
      }
    },
    "installation_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "requirement",
        "scope",
        "owner",
        "bundle",
        "locations",
        "recommendations",
        "conditions",
        "depends_on",
        "commands",
        "protocol",
        "verification",
        "fallback",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/installation_id"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "enum": [
            "recommended",
            "optional",
            "conditional"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "bundle": {
          "type": [
            "string",
            "null"
          ]
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/installation_id"
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/installation_command"
          }
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "description": "Instructions to verify writing, loading and behavior separately; never live installation evidence.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "written",
            "loading",
            "effect"
          ],
          "properties": {
            "written": {
              "type": "string",
              "minLength": 1
            },
            "loading": {
              "type": "string",
              "minLength": 1
            },
            "effect": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "refresh",
            "remove",
            "rollback"
          ],
          "properties": {
            "refresh": {
              "type": "string",
              "minLength": 1
            },
            "remove": {
              "type": "string",
              "minLength": 1
            },
            "rollback": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "installation_catalog": {
      "description": "Offline capability guidance from the current runtime. It performs neither host discovery nor installation verification.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_version",
        "runtime_version",
        "compatibility",
        "entrypoints",
        "host_discovery",
        "installation_verification",
        "side_effects",
        "boundaries",
        "bundles",
        "items"
      ],
      "properties": {
        "catalog_version": {
          "const": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog_contract",
            "runtime_contract",
            "existing_installations"
          ],
          "properties": {
            "catalog_contract": {
              "type": "string",
              "minLength": 1
            },
            "runtime_contract": {
              "type": "string",
              "minLength": 1
            },
            "existing_installations": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/installation_command"
          }
        },
        "host_discovery": {
          "const": "not_performed"
        },
        "installation_verification": {
          "const": "not_performed"
        },
        "side_effects": {
          "const": "none"
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "members",
              "selection"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/installation_id"
                }
              },
              "selection": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/installation_item"
          }
        }
      }
    },
    "project_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "git_dir",
        "common_dir",
        "head",
        "branch",
        "dirty",
        "remote",
        "repository"
      ],
      "properties": {
        "root": {"type": "string"},
        "git_dir": {"type": "string"},
        "common_dir": {"type": "string"},
        "head": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "branch": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"},
        "remote": {"type": "string"},
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "host", "path"],
          "properties": {
            "provider": {"enum": ["github", "gitlab"]},
            "host": {"type": "string"},
            "path": {"type": "string"}
          }
        }
      }
    },
    "doctor_runtime_update": {
      "description": "Advisory official release metadata only; never changes health, exit status or update authorization. Signature verification occurs only during an explicit update.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "current_version", "latest_version", "diagnostic"],
      "properties": {
        "status": {"enum": ["not_checked", "up_to_date", "update_available", "current_newer", "unknown"]},
        "current_version": {"type": "string", "minLength": 1},
        "latest_version": {"type": ["string", "null"]},
        "diagnostic": {"$ref": "#/$defs/probe/properties/diagnostic"}
      }
    },
    "doctor_local": {
      "description": "Read-only local facts. Current means repository and branch ownership only; recorded IDs and target are not native verification or write eligibility.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "context",
        "target",
        "checkpoint",
        "remote_state"
      ],
      "properties": {
        "status": {
          "enum": [
            "initialized",
            "uninitialized",
            "checkpoint_branch_mismatch",
            "not_checked"
          ]
        },
        "context": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/project_context"}
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint": {
          "$ref": "#/$defs/doctor_checkpoint"
        },
        "remote_state": {
          "const": "not_checked"
        }
      }
    },
    "doctor_health_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "severity", "repairable", "evidence", "diagnostic"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["current", "change_required", "not_selected", "not_checked", "unknown", "needs_initialization"]},
        "severity": {"enum": ["info", "warning", "error"]},
        "repairable": {"type": "boolean"},
        "evidence": {},
        "diagnostic": {"$ref": "#/$defs/probe/properties/diagnostic"}
      }
    },
    "doctor_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "checks", "host_behavior"],
      "properties": {
        "scope": {"enum": ["project_static", "account_only"]},
        "status": {"enum": ["healthy", "attention", "unknown", "not_checked"]},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/doctor_health_check"}},
        "host_behavior": {"const": "not_verified"}
      }
    },
    "doctor_maintenance_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "state": {"enum": ["created", "updated", "removed"]}
      }
    },
    "doctor_repair_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assets"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/doctor_maintenance_asset"}}
      }
    },
    "doctor_repair_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "transaction", "diagnostic"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["applied", "failed", "skipped"]},
        "transaction": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["transaction", "changes"], "properties": {
              "transaction": {"type": "string", "minLength": 1},
              "changes": {"type": "integer", "minimum": 0}
            }}
          ]
        },
        "diagnostic": {"$ref": "#/$defs/probe/properties/diagnostic"}
      }
    },
    "doctor_repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "dry_run", "plans", "results", "before", "recheck"],
      "properties": {
        "requested": {"type": "boolean"},
        "dry_run": {"type": "boolean"},
        "plans": {"type": "array", "items": {"$ref": "#/$defs/doctor_repair_plan"}},
        "results": {"type": "array", "items": {"$ref": "#/$defs/doctor_repair_result"}},
        "before": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/doctor_health"}]},
        "recheck": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/doctor_health"}]}
      }
    },
    "doctor_agent_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "argv", "cwd", "scope", "authorization"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string", "minLength": 1},
        "scope": {"const": "project"},
        "authorization": {"const": "existing_session_only"}
      }
    },
    "doctor_agent_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "finding", "evidence_pointer", "reason", "certainty", "recommendation", "command", "preconditions", "verification"],
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "finding": {"enum": ["unknown", "change_required", "needs_initialization"]},
        "evidence_pointer": {"type": "string", "pattern": "^/evidence/health/checks/[0-9]+$"},
        "reason": {"type": "string", "minLength": 1},
        "certainty": {"enum": ["observed", "unconfirmed"]},
        "recommendation": {"type": "string", "minLength": 1},
        "command": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/doctor_agent_command"}]},
        "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verification": {"type": "string", "minLength": 1}
      }
    },
    "doctor_agent_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "max_rounds", "skill", "stop_conditions", "scope", "host_behavior"],
      "properties": {
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/doctor_agent_task"}},
        "max_rounds": {"const": 3},
        "skill": {"const": "specgit-native"},
        "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "scope": {"const": "project_static"},
        "host_behavior": {"const": "not_verified"}
      }
    },
    "doctor_checkpoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "absent",
                "not_checked"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "recorded_branch",
            "recorded_target",
            "issues",
            "request"
          ],
          "properties": {
            "status": {
              "const": "current"
            },
            "recorded_branch": {
              "type": "string"
            },
            "recorded_target": {
              "type": "string"
            },
            "issues": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "request": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "path",
            "recorded_branch",
            "recorded_target",
            "recorded_project_id",
            "current_branch",
            "pending_write",
            "write_eligible"
          ],
          "properties": {
            "status": {
              "const": "branch_mismatch"
            },
            "path": {
              "type": "string"
            },
            "recorded_branch": {
              "type": "string"
            },
            "recorded_target": {
              "type": "string"
            },
            "recorded_project_id": {
              "type": "integer",
              "minimum": 1
            },
            "current_branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "pending_write": {
              "type": "boolean"
            },
            "write_eligible": {
              "const": false
            }
          }
        }
      ]
    },
    "hook_purpose": {
      "enum": ["guard", "context", "observe"]
    },
    "host_hook_purposes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "installed", "declined"],
      "properties": {
        "requested": {"type":"array","uniqueItems":true,"items":{"enum":["guard","context","observe","none"]}},
        "installed": {"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/hook_purpose"}},
        "declined": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["purpose", "status", "reason"],
            "properties": {
              "purpose": {"$ref":"#/$defs/hook_purpose"},
              "status": {"enum":["unknown","unsupported"]},
              "reason": {"type":"string","minLength":1}
            }
          }
        }
      }
    },
    "hook_purposes": {
      "type": "object",
      "propertyNames": {"enum":["generic","claude","codex","opencode"]},
      "additionalProperties": {"$ref":"#/$defs/host_hook_purposes"}
    },
    "setup_host_delivery": {
      "description": "Setup records configuration only, never observed host delivery or wake verification.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "imported_event": {"const":"not_checked"},
        "context_injection": {"const":"not_checked"},
        "visible_message": {"const":"not_checked"},
        "next_turn": {"const":"not_checked"},
        "idle_wake": {"enum":["not_supported","configured_not_verified"]}
      }
    },
    "milestone_scope": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["kind","project_id"],"properties":{
          "kind":{"const":"project"},"project_id":{"type":"integer","minimum":1}
        }},
        {"type":"object","additionalProperties":false,"required":["kind","group_id"],"properties":{
          "kind":{"const":"group"},"group_id":{"type":"integer","minimum":1}
        }}
      ]
    },
    "milestone": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["provider","id","number","title","state","url"],"properties":{
          "provider":{"const":"github"},"id":{"type":"integer","minimum":1},
          "number":{"type":"integer","minimum":1},"title":{"type":"string","minLength":1},
          "state":{"enum":["open","closed"]},"url":{"type":"string","pattern":"^https?://[^/?#@\\s]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/milestone/[1-9][0-9]*$"}
        }},
        {"type":"object","additionalProperties":false,"required":["provider","id","iid","title","state","scope","url"],"properties":{
          "provider":{"const":"gitlab"},"id":{"type":"integer","minimum":1},
          "iid":{"type":"integer","minimum":1},"title":{"type":"string","minLength":1},
          "state":{"enum":["active","closed"]},"scope":{"$ref":"#/$defs/milestone_scope"},
          "url":{"type":["string","null"],"pattern":"^https?://[^/?#@\\s]+/(?:[A-Za-z0-9._-]+/)+-/milestones/[1-9][0-9]*$"}
        }}
      ]
    },
    "milestone_context": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["status","milestone"],"properties":{
          "status":{"const":"linked"},"milestone":{"$ref":"#/$defs/milestone"}
        }},
        {"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"const":"none"}}},
        {"type":"object","additionalProperties":false,"required":["status","reason"],"properties":{
          "status":{"const":"unknown"},"reason":{"type":"string","minLength":1}
        }}
      ]
    },
    "environment_fact": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["status","value","source"],"properties":{
          "status":{"const":"known"},
          "value":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9.+_-]+$"},
          "source":{"enum":["host","GET metadata"]}
        }},
        {"type":"object","additionalProperties":false,"required":["status","reason","source"],"properties":{
          "status":{"const":"unknown"},
          "reason":{"type":"string","minLength":1,"maxLength":256},
          "source":{"enum":["host","GET metadata"]}
        }}
      ]
    },
    "gitlab_environment": {
      "type":"object",
      "additionalProperties":false,
      "required":["host","metadata_status","diagnostic","deployment","server_version","edition","subscription"],
      "properties":{
        "host":{"type":"string","minLength":1,"maxLength":253},
        "metadata_status":{"enum":["known","unknown"]},
        "diagnostic":{"$ref":"#/$defs/probe/properties/diagnostic"},
        "deployment":{"$ref":"#/$defs/environment_fact","properties":{"value":{"const":"official_hosted"}}},
        "server_version":{"$ref":"#/$defs/environment_fact","properties":{"value":{"pattern":"^[0-9][A-Za-z0-9.+_-]*$"}}},
        "edition":{"$ref":"#/$defs/environment_fact","properties":{"value":{"enum":["ce","ee"]}}},
        "subscription":{"$ref":"#/$defs/environment_fact","properties":{"status":{"const":"unknown"}}}
      }
    },
    "skill_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "path", "action", "dry_run", "edited", "backup"],
      "properties": {
        "scope": {"const": "user"},
        "path": {"type": ["string", "null"]},
        "action": {"enum": ["install", "refresh", "remove", "skip"]},
        "dry_run": {"type": "boolean"},
        "edited": {"type": "boolean"},
        "backup": {"type": ["string", "null"]}
      }
    },
    "inspection_activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "elapsed_ms", "outcome"],
      "properties": {
        "operation": {"type": "string", "minLength": 1},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "outcome": {"enum": ["finished", "failed", "timed_out"]}
      }
    },
    "pagination_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "pages_fetched", "items_seen", "page_limit"],
      "properties": {
        "status": {"enum": ["complete", "incomplete", "not_applicable", "budget_exhausted"]},
        "pages_fetched": {"type": "integer", "minimum": 0},
        "items_seen": {"type": "integer", "minimum": 0},
        "page_limit": {"type": "integer", "minimum": 0}
      }
    },
    "inspection_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "budget_ms", "elapsed_ms", "requests_executed", "complete", "budget_exhausted", "pagination", "activities"],
      "properties": {
        "status": {"enum": ["complete", "incomplete", "not_run", "budget_exhausted"]},
        "budget_ms": {"type": "integer", "minimum": 1},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "requests_executed": {"type": "integer", "minimum": 0},
        "complete": {"type": "boolean"},
        "budget_exhausted": {"type": "boolean"},
        "pagination": {"$ref": "#/$defs/pagination_summary"},
        "activities": {"type": "array", "items": {"$ref": "#/$defs/inspection_activity"}}
      }
    },
    "candidate_pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages_fetched", "items_seen", "page_limit", "complete"],
      "properties": {
        "pages_fetched": {"type": "integer", "minimum": 0},
        "items_seen": {"type": "integer", "minimum": 0},
        "page_limit": {"type": "integer", "minimum": 1},
        "complete": {"type": "boolean"}
      }
    },
    "history_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state", "updated_at"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "title": {"type": "string"},
        "state": {"const": "closed"},
        "state_reason": {"type": "string"},
        "updated_at": {"type": "string"},
        "url": {"type": "string"}
      }
    },
    "candidate_preflight": {
      "type": "object",
      "required": ["title", "issues", "history", "history_diagnostics", "review_digest", "elapsed_ms", "requests_executed", "pagination"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "issues": {"type": "array", "items": {"type": "object"}},
        "history": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/history_issue"}},
        "history_diagnostics": {"$ref": "#/properties/diagnostics"},
        "review_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "requests_executed": {"type": "integer", "minimum": 0},
        "pagination": {"$ref": "#/$defs/candidate_pagination"}
      },
      "additionalProperties": true
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "status", "observed_at", "elapsed_ms", "diagnostic", "evidence"],
      "properties": {
        "operation": {"type": "string", "minLength": 1},
        "status": {"enum": ["available", "unavailable", "forbidden", "unknown", "not_checked"]},
        "observed_at": {"type": "integer", "minimum": 0},
        "elapsed_ms": {"type": ["integer", "null"], "minimum": 0},
        "diagnostic": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["code", "operation", "message", "remedy"], "properties": {
              "code": {"type": "string", "minLength": 1},
              "operation": {"type": "string", "minLength": 1},
              "message": {"type": "string", "minLength": 1},
              "remedy": {"type": "string", "minLength": 1}
            }}
          ]
        },
        "evidence": {}
      }
    },
    "watch_action_kind": {
      "enum": [
        "wait_for_checks",
        "inspect_checks",
        "repair_checks",
        "interpret_checks",
        "prepare_review",
        "review_or_merge_on_platform",
        "inspect_open_issues",
        "verify_issue_closure",
        "reopen_or_choose_followup",
        "refresh_native_evidence",
        "reconcile_subscription",
        "resume_subscription",
        "completed"
      ]
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "goal",
        "request_id",
        "request_state",
        "check_outcome",
        "draft",
        "auto_merge",
        "close_issues_after_merge",
        "issue_ids",
        "failed_checks",
        "diagnostics",
        "message",
        "command",
        "requires_user_authorization"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/watch_action_kind"
        },
        "goal": {
          "enum": ["checks", "lifecycle"]
        },
        "request_id": {
          "type": "integer",
          "minimum": 1
        },
        "request_state": {
          "type": ["string", "null"]
        },
        "check_outcome": {
          "enum": ["unobserved", "pending", "passed", "completed", "failed"]
        },
        "draft": {
          "type": ["boolean", "null"]
        },
        "auto_merge": {
          "enum": ["registered", "not_registered", "unknown", null]
        },
        "close_issues_after_merge": {
          "type": "boolean"
        },
        "issue_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "failed_checks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "diagnostics": {
          "type": "array",
          "items": {"type": "string"}
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": ["string", "null"]
        },
        "requires_user_authorization": {
          "type": "boolean",
          "description": "The suggested action needs authorization for its scope. Existing user delegation of the current workflow satisfies it; true does not request renewed confirmation. The observer never performs the action."
        }
      }
    },
    "init_check_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit"],
      "properties": {
        "repository": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "host", "path"],
              "properties": {
                "provider": {"enum": ["github", "gitlab"]},
                "host": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "branch": {"type": ["string", "null"]},
        "commit": {
          "type": ["string", "null"],
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        }
      }
    },
    "update_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "repository", "platform", "executable", "current_version", "target_source", "target_version", "release_tag", "direction", "update_available", "asset", "verification", "installation", "user_skill"],
      "properties": {
        "mode": {"enum": ["check", "dry_run", "apply"]},
        "repository": {"const": "LeXwDeX/SpecGit"},
        "platform": {"enum": ["darwin-arm64", "linux-x64-gnu", "win32-x64", null]},
        "executable": {"type": ["string", "null"], "minLength": 1},
        "current_version": {"type": "string", "minLength": 1},
        "target_source": {"enum": ["latest", "requested"]},
        "target_version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "release_tag": {"type": ["string", "null"], "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "direction": {"enum": ["same", "upgrade", "downgrade", "current_newer", null]},
        "update_available": {"type": "boolean"},
        "user_skill": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["status", "report"], "properties": {
              "status": {"enum": ["refreshed", "skipped", "failed"]},
              "report": {"type": ["object", "null"]}
            }}
          ]
        },
        "asset": {"type": ["string", "null"], "pattern": "^specgit-[0-9]+\\.[0-9]+\\.[0-9]+-(darwin-arm64|linux-x64-gnu|win32-x64)\\.zip$"},
        "verification": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["signature", "certificate_identity", "certificate_oidc_issuer", "manifest_row", "archive_sha256", "executable_sha256", "extracted_version"],
              "properties": {
                "signature": {"const": "verified"},
                "certificate_identity": {"const": "https://github.com/LeXwDeX/SpecGit/.github/workflows/release-prepare.yml@refs/heads/main"},
                "certificate_oidc_issuer": {"const": "https://token.actions.githubusercontent.com"},
                "manifest_row": {"const": "matched"},
                "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "extracted_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
              }
            }
          ]
        },
        "installation": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["executable", "backup", "previous_version", "installed_version", "executable_sha256"],
              "properties": {
                "executable": {"type": "string", "minLength": 1},
                "backup": {"type": "string", "minLength": 1},
                "previous_version": {"type": "string", "minLength": 1},
                "installed_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
                "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          ]
        }
      }
    },
    "init_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "requirement_source",
        "status",
        "presentation",
        "applies_to",
        "scope",
        "source",
        "observed_at",
        "diagnostic",
        "reason",
        "next_step"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["required", "recommended", "optional"]},
        "requirement_source": {"enum": ["builtin", "project_declaration"]},
        "status": {"enum": ["verified", "not_configured", "failed", "unknown", "not_checked", "not_applicable"]},
        "presentation": {"enum": ["pass", "hint", "warning", "blocking"]},
        "applies_to": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "scope": {"$ref": "#/$defs/init_check_scope"},
        "source": {"type": "string", "minLength": 1},
        "observed_at": {"type": ["integer", "null"], "minimum": 0},
        "diagnostic": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "operation", "message", "remedy"],
              "properties": {
                "code": {"type": "string", "minLength": 1},
                "operation": {"type": "string", "minLength": 1},
                "message": {"type": "string", "minLength": 1},
                "remedy": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "next_step": {"type": "string", "minLength": 1}
      }
    },
    "init_operation_assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "note", "operations"],
      "properties": {
        "scope": {"const": "reported_checks_only"},
        "note": {"type": "string", "minLength": 1},
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "assessment", "relevant_checks", "blocked_by", "unverified_by", "warnings"],
            "properties": {
              "operation": {"type": "string", "minLength": 1},
              "assessment": {"enum": ["blocked", "unverified", "no_reported_blocker"]},
              "relevant_checks": {"type": "array", "items": {"type": "string"}},
              "blocked_by": {"type": "array", "items": {"type": "string"}},
              "unverified_by": {"type": "array", "items": {"type": "string"}},
              "warnings": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "init_availability_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "checks", "facts", "blocked_by", "unverified_by", "warnings", "next_step"],
      "properties": {
        "id": {"enum": ["specification_development", "protected_delivery", "delivery_completion"]},
        "status": {"enum": ["ready", "blocked", "unverified"]},
        "checks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "facts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "blocked_by": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "unverified_by": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "next_step": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
          "then": {"properties": {"blocked_by": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]},
          "then": {
            "properties": {
              "blocked_by": {"maxItems": 0},
              "unverified_by": {"maxItems": 0},
              "warnings": {"maxItems": 0}
            },
            "anyOf": [
              {"properties": {"checks": {"minItems": 1}}},
              {"properties": {"facts": {"minItems": 1}}}
            ]
          }
        },
        {
          "if": {"properties": {"status": {"const": "unverified"}}, "required": ["status"]},
          "then": {
            "properties": {"blocked_by": {"maxItems": 0}},
            "anyOf": [
              {"properties": {"unverified_by": {"minItems": 1}}},
              {"properties": {"warnings": {"minItems": 1}}}
            ]
          }
        }
      ]
    },
    "init_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "note", "layers"],
      "properties": {
        "scope": {"const": "reported_init_facts_only"},
        "note": {"type": "string", "minLength": 1},
        "layers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/init_availability_layer"}, {"properties": {"id": {"const": "specification_development"}}}]},
            {"allOf": [{"$ref": "#/$defs/init_availability_layer"}, {"properties": {"id": {"const": "protected_delivery"}}}]},
            {"allOf": [{"$ref": "#/$defs/init_availability_layer"}, {"properties": {"id": {"const": "delivery_completion"}}}]}
          ],
          "items": false
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 2
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "exit": {
      "enum": [
        0,
        1,
        2,
        3,
        130
      ]
    },
    "evidence": {},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "remedy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "operation",
          "message",
          "remedy"
        ]
      }
    },
    "ok": {
      "type": "boolean",
      "description": "Exactly exit == 0; successful observation does not grant merge permission."
    },
    "next_actions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/next_action"
          },
          {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "$ref": "#/$defs/watch_action_kind"
                }
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "description": "Typed watch next steps or other diagnostic guidance, never additional authorization or an automatically executed action."
    },
    "effects": {
      "type": "object",
      "description": "Typed side-effect outcomes when available. Unknown results require readback before retry.",
      "additionalProperties": false,
      "required": [
        "operations",
        "outcome"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "action",
              "outcome",
              "recovery"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "local",
                  "native"
                ]
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "unknown",
                  "applied"
                ]
              },
              "recovery": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "outcome": {
          "enum": [
            "not_applied",
            "applied",
            "unknown"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "version",
    "operation",
    "status",
    "exit",
    "evidence",
    "diagnostics",
    "ok",
    "next_actions"
  ],
  "description": "One ordinary command stdout JSON document. Exit 0 means the operation or observation succeeded, never acceptance or authorization to merge. Hook output follows its explicit host framing instead. Future fields require the corresponding versioned contract.",
  "allOf": [
    {"if":{"properties":{"operation":{"const":"setup"},"status":{"const":"catalog"}},"required":["operation","status"]},"then":{"properties":{"ok":{"const":true},"exit":{"const":0},"evidence":{"type":"object","additionalProperties":false,"required":["installation_catalog"],"properties":{"installation_catalog":{"$ref":"#/$defs/installation_catalog"}}}}}},
    {"if":{"properties":{"operation":{"const":"doctor"},"evidence":{"type":"object"}},"required":["operation","evidence"]},"then":{"properties":{"status":{"enum":["ready","offline_checked","attention_required","checkpoint_branch_mismatch","unknown","repair_failed","invalid_input","rejected"]},"evidence":{"properties":{"runtime_update":{"$ref":"#/$defs/doctor_runtime_update"},"local":{"$ref":"#/$defs/doctor_local"},"health":{"$ref":"#/$defs/doctor_health"},"repair":{"$ref":"#/$defs/doctor_repair"},"agent_guidance":{"$ref":"#/$defs/doctor_agent_guidance"}}}}}},
    {"if":{"properties":{"operation":{"const":"doctor"},"exit":{"const":0}},"required":["operation","exit"]},"then":{"properties":{"evidence":{"type":"object","required":["local"],"properties":{"local":{"$ref":"#/$defs/doctor_local"}}}}}},
    {
      "if": {"properties":{"operation":{"const":"setup"},"evidence":{"type":"object"}},"required":["operation","evidence"]},
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "hook_purposes": {"$ref":"#/$defs/hook_purposes"},
              "host_delivery": {"$ref":"#/$defs/setup_host_delivery"},
              "installation_catalog": {"$ref":"#/$defs/installation_catalog"}
            }
          }
        }
      }
    },
    {
      "if":{"properties":{"operation":{"enum":["init","doctor"]},"evidence":{"type":"object"}},"required":["operation","evidence"]},
      "then":{"properties":{"evidence":{"properties":{"environment":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/gitlab_environment"}]}}}}}
    },
    {
      "if": {"properties": {"operation": {"const": "skill"}}, "required": ["operation"]},
      "then": {"properties": {"evidence": {"$ref": "#/$defs/skill_evidence"}}, "required": ["effects"]}
    },
    {
      "if": {
        "properties": {
          "operation": {"const": "init"},
          "evidence": {"type": "object"}
        },
        "required": ["operation", "evidence"]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "availability": {"$ref": "#/$defs/init_availability"},
              "inspection": {"$ref": "#/$defs/inspection_summary"},
              "operation_assessments": {"$ref": "#/$defs/init_operation_assessments"},
              "probes": {"type": "array", "items": {"$ref": "#/$defs/probe"}},
              "checks": {
                "type": "array",
                "items": {"$ref": "#/$defs/init_check"}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"const": "issue"},
          "evidence": {"type": "object"}
        },
        "required": ["operation", "evidence"]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "inspection": {"$ref": "#/$defs/inspection_summary"},
              "milestones": {"type":"object","propertyNames":{"pattern":"^[1-9][0-9]*$"},"additionalProperties":{"$ref":"#/$defs/milestone_context"}},
              "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate_preflight"}}
            },
            "if": {"required": ["review_digest"]},
            "then": {"$ref": "#/$defs/candidate_preflight"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"const": "update"},
          "evidence": {"type": "object"}
        },
        "required": ["operation", "evidence"]
      },
      "then": {
        "properties": {
          "evidence": {"$ref": "#/$defs/update_evidence"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit": {
            "const": 0
          }
        },
        "required": [
          "exit"
        ]
      },
      "then": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      }
    }
  ]
}

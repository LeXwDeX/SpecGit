{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecGit 2 JSON report",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "watch_action_kind": {
      "enum": [
        "wait_for_checks",
        "inspect_checks",
        "repair_checks",
        "interpret_checks",
        "prepare_review",
        "review_or_merge_on_platform",
        "inspect_open_issues",
        "verify_issue_closure",
        "reopen_or_choose_followup",
        "refresh_native_evidence",
        "reconcile_subscription",
        "resume_subscription",
        "completed"
      ]
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "goal",
        "request_id",
        "request_state",
        "check_outcome",
        "draft",
        "auto_merge",
        "close_issues_after_merge",
        "issue_ids",
        "failed_checks",
        "diagnostics",
        "message",
        "command",
        "requires_user_authorization"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/watch_action_kind"
        },
        "goal": {
          "enum": ["checks", "lifecycle"]
        },
        "request_id": {
          "type": "integer",
          "minimum": 1
        },
        "request_state": {
          "type": ["string", "null"]
        },
        "check_outcome": {
          "enum": ["unobserved", "pending", "passed", "completed", "failed"]
        },
        "draft": {
          "type": ["boolean", "null"]
        },
        "auto_merge": {
          "enum": ["registered", "not_registered", "unknown", null]
        },
        "close_issues_after_merge": {
          "type": "boolean"
        },
        "issue_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "failed_checks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "diagnostics": {
          "type": "array",
          "items": {"type": "string"}
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": ["string", "null"]
        },
        "requires_user_authorization": {
          "type": "boolean"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 2
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "exit": {
      "enum": [
        0,
        1,
        2,
        3,
        130
      ]
    },
    "evidence": {},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "remedy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "operation",
          "message",
          "remedy"
        ]
      }
    },
    "ok": {
      "type": "boolean",
      "description": "Exactly exit == 0; successful observation does not grant merge permission."
    },
    "next_actions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/next_action"
          },
          {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "$ref": "#/$defs/watch_action_kind"
                }
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "description": "Typed watch next steps or other diagnostic guidance, never additional authorization or an automatically executed action."
    },
    "effects": {
      "type": "object",
      "description": "Typed side-effect outcomes when available. Unknown results require readback before retry.",
      "additionalProperties": false,
      "required": [
        "operations",
        "outcome"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "action",
              "outcome",
              "recovery"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "local",
                  "native"
                ]
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "unknown",
                  "applied"
                ]
              },
              "recovery": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "outcome": {
          "enum": [
            "not_applied",
            "applied",
            "unknown"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "version",
    "operation",
    "status",
    "exit",
    "evidence",
    "diagnostics",
    "ok",
    "next_actions"
  ],
  "description": "One ordinary command stdout JSON document. Exit 0 means the operation or observation succeeded, never acceptance or authorization to merge. Hook output follows its explicit host framing instead. Future fields require the corresponding versioned contract.",
  "allOf": [
    {
      "if": {
        "properties": {
          "exit": {
            "const": 0
          }
        },
        "required": [
          "exit"
        ]
      },
      "then": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      }
    }
  ]
}

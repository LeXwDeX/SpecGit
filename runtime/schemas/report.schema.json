{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecGit 2 JSON report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "exit": {
      "enum": [
        0,
        1,
        2,
        3,
        130
      ]
    },
    "evidence": {},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "remedy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "operation",
          "message",
          "remedy"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "version",
    "operation",
    "status",
    "exit",
    "evidence",
    "diagnostics"
  ],
  "description": "One ordinary command stdout document. Exit 0 indicates a successful observation; only finish status accepted proves acceptance. Hook output follows its host protocol separately."
}

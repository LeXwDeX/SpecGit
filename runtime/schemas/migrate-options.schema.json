{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecGit 2 explicit migration options",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "config_file": {"type":"string", "minLength":1},
    "apply": {"type":"boolean", "default":false},
    "expect": {"type":"string", "pattern":"^[a-f0-9]{64}$"},
    "retire_only": {"type":"boolean", "default":false},
    "api_host": {"type":"string", "minLength":1},
    "rollback": {"type":"string", "minLength":1}
  },
  "oneOf": [
    {"required":["rollback"], "not":{"anyOf":[{"required":["config_file"]},{"required":["apply"]},{"required":["expect"]},{"required":["retire_only"]},{"required":["api_host"]}]}},
    {"required":["config_file"], "not":{"required":["rollback"]}}
  ],
  "allOf": [
    {"if":{"required":["apply"],"properties":{"apply":{"const":true}}}, "then":{"required":["expect"]}},
    {"if":{"required":["expect"]}, "then":{"required":["apply"], "properties":{"apply":{"const":true}}}}
  ]
}

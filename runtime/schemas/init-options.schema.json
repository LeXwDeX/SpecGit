{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecGit 2 init options",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "remote": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "provider": {
      "enum": [
        "github",
        "gitlab",
        null
      ]
    },
    "api_host": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "target": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "language": {
      "enum": [
        "en",
        "zh",
        null
      ]
    },
    "config_file": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "mirror_claude": {
      "type": "boolean",
      "default": false
    },
    "native_delete_source": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "inspect": {
      "type": "boolean",
      "default": false
    },
    "rollback": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "description": "Normalized CLI options, not a JSON-input transport. Optional null values mean absent. Global --json and --cwd are described in cli-options.schema.json; command-specific cross-option preflight remains authoritative.",
  "allOf": [
    {
      "if": {
        "required": [
          "inspect"
        ],
        "properties": {
          "inspect": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "native_delete_source": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "rollback"
        ],
        "properties": {
          "rollback": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "config_file": {
            "type": "null"
          },
          "language": {
            "type": "null"
          },
          "target": {
            "type": "null"
          },
          "api_host": {
            "type": "null"
          },
          "native_delete_source": {
            "type": "null"
          },
          "inspect": {
            "const": false
          },
          "mirror_claude": {
            "const": false
          }
        }
      }
    }
  ]
}

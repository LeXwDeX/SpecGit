{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecGit 2 setup options",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "root": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "provider": {
      "enum": [
        "github",
        "gitlab",
        null
      ]
    },
    "api_host": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "register_claude": {
      "type": "boolean",
      "default": false
    },
    "claude_settings": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "uninstall": {
      "type": "boolean",
      "default": false
    },
    "rollback": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "description": "Normalized CLI options, not a JSON-input transport. Optional null values mean absent. Global --json and --cwd are described in cli-options.schema.json; command-specific cross-option preflight remains authoritative.",
  "allOf": [
    {
      "if": {
        "required": [
          "claude_settings"
        ],
        "properties": {
          "claude_settings": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "register_claude"
        ],
        "properties": {
          "register_claude": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "uninstall"
        ],
        "properties": {
          "uninstall": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "rollback": {
            "type": "null"
          }
        }
      }
    }
  ]
}
